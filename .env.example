# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/pmploy

# Auth
JWT_SECRET=replace-with-long-random-string
ENV_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Caddy Admin API
CADDY_ADMIN_URL=http://localhost:2019

# GitHub App (configured in UI; these are fallback defaults)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# Deploy workspace
PMPLOY_DATA_DIR=./.pmploy-data

# Where pmPloy is cloned. Used by the self-updater. Defaults to the API's cwd.
PMPLOY_REPO_PATH=

# Comma-separated emails allowed to run platform updates. If unset, the
# user with the earliest createdAt becomes the platform admin.
PLATFORM_ADMINS=

# --- Web ---
VITE_API_URL=http://localhost:4000
